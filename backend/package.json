{
  "name": "ai-playwright-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic AI-powered web test automation backend (natural language scenarios -> Playwright execution)",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install --with-deps chromium firefox webkit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rename-web-tables": "tsx src/db/renameWebTables.ts",
    "create-admin": "tsx src/db/createAdminUser.ts"
  },
  "dependencies": {
    "@zilliz/milvus2-sdk-node": "^2.4.9",
    "allure": "^3.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ldapts": "^8.1.8",
    "nanoid": "^5.0.7",
    "oracledb": "^6.6.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
