# Sunucu
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# LLM sağlayıcı — "openrouter" ya da "gemini". Sadece SEÇTİĞİNİZ sağlayıcının API anahtarı
# zorunludur; diğerini boş bırakabilirsiniz.
LLM_PROVIDER=openrouter

# --- OpenRouter (ücretsiz katman) --- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter, istekleri değerlendirmek için bu bilgileri ister (opsiyonel ama önerilir)
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_APP_NAME=AI-Playwright-Automation

# --- Google Gemini (ücretsiz katman) --- https://aistudio.google.com/apikey
# GEMINI_MODEL için BİLİNÇLİ OLARAK varsayılan bir değer YOKTUR — Google'ın ücretsiz/kullanılabilir
# model adları zaman zaman değişiyor (bir model aniden "yeni kullanıcılara artık açık değil" hâline
# gelebiliyor). LLM_PROVIDER="gemini" iken bu değeri AÇIKÇA doldurmanız gerekir; boş bırakırsanız
# uygulama başlangıçta net bir hata ile durur. Güncel model adını doğrulamak için:
#   1) https://aistudio.google.com/ üzerinden hesabınızla kullanılabilir modelleri kontrol edin, VEYA
#   2) Aşağıdaki komutu kendi terminalinizde çalıştırın (API anahtarınızı asla ekrana yazdırmaz):
#      KEY=$(grep 'GEMINI_API_KEY=' .env | sed -E 's/^[[:space:]]*GEMINI_API_KEY=//') && \
#      curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY" | \
#      python3 -c "import json,sys; d=json.load(sys.stdin); [print(m['name']) for m in d.get('models',[]) if 'generateContent' in m.get('supportedGenerationMethods',[])]"
# Yanlış/kullanılamayan bir model girerseniz, GeminiProvider.validateConfig() bunu herhangi bir
# test adımı (ve Playwright/tarayıcı) başlamadan ÖNCE, açık bir yapılandırma hatasıyla bildirir.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ajan / güvenlik limitleri
AGENT_MAX_STEPS=40
AGENT_MAX_REPEATED_ACTIONS=3
AGENT_MIN_CONFIDENCE=0.55
AGENT_STEP_TIMEOUT_MS=15000
AGENT_MAX_ELEMENTS_PER_STEP=80
# LLM isteği (hangi sağlayıcı seçiliyse) bu süreden uzun sürerse iptal edilip adım yeniden denenir.
# Ücretsiz modeller yoğun saatlerde yavaş olabildiği için bilinçli olarak yüksek tutulmuştur.
AGENT_LLM_TIMEOUT_MS=45000

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=10000

# Loglama
RUNS_DIR=./runs
ARTIFACTS_DIR=./artifacts
GENERATED_TESTS_DIR=./generated-tests

# Allure raporu (bkz. AllureReportService) — "allure" npm paketi (Allure Report 3) node_modules
# içine kurulur, ekstra bir kurulum gerekmez.
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# Eski (legacy) frontend uyum katmanı
LEGACY_DEFAULT_BROWSER=chromium

# Statik frontend dosyalarının bulunduğu klasör (backend tarafından aynı origin'den sunulur).
# Varsayılan, backend'in bir üst dizinindeki "frontend" klasörünü varsayar.
FRONTEND_DIR=../frontend
