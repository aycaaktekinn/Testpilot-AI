# Sunucu
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# LLM sağlayıcı — "openrouter", "gemini" ya da "ollama". Sadece SEÇTİĞİNİZ sağlayıcının ayarları
# zorunludur; diğerlerini boş bırakabilirsiniz.
LLM_PROVIDER=openrouter

# --- OpenRouter (ücretsiz katman) --- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter, istekleri değerlendirmek için bu bilgileri ister (opsiyonel ama önerilir)
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_APP_NAME=AI-Playwright-Automation

# --- Google Gemini (ücretsiz katman) --- https://aistudio.google.com/apikey
# GEMINI_MODEL için BİLİNÇLİ OLARAK varsayılan bir değer YOKTUR — Google'ın ücretsiz/kullanılabilir
# model adları zaman zaman değişiyor (bir model aniden "yeni kullanıcılara artık açık değil" hâline
# gelebiliyor). LLM_PROVIDER="gemini" iken bu değeri AÇIKÇA doldurmanız gerekir; boş bırakırsanız
# uygulama başlangıçta net bir hata ile durur. Güncel model adını doğrulamak için:
#   1) https://aistudio.google.com/ üzerinden hesabınızla kullanılabilir modelleri kontrol edin, VEYA
#   2) Aşağıdaki komutu kendi terminalinizde çalıştırın (API anahtarınızı asla ekrana yazdırmaz):
#      KEY=$(grep 'GEMINI_API_KEY=' .env | sed -E 's/^[[:space:]]*GEMINI_API_KEY=//') && \
#      curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY" | \
#      python3 -c "import json,sys; d=json.load(sys.stdin); [print(m['name']) for m in d.get('models',[]) if 'generateContent' in m.get('supportedGenerationMethods',[])]"
# Yanlış/kullanılamayan bir model girerseniz, GeminiProvider.validateConfig() bunu herhangi bir
# test adımı (ve Playwright/tarayıcı) başlamadan ÖNCE, açık bir yapılandırma hatasıyla bildirir.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Ollama (yerel/offline, ücretsiz) --- https://ollama.com/download
# v2.3 — bulutta DEĞİL, kendi makinenizde `ollama serve` ile çalışır; API anahtarı GEREKMEZ.
# Kurulum: 1) Ollama'yı kurup çalıştırın, 2) bir "chat/instruct" modeli indirin
# (ör. `ollama pull llama3.1` — büyük/karmaşık senaryolarda daha güçlü bir model tercih edin),
# 3) LLM_PROVIDER=ollama yapıp aşağıdaki iki satırı doldurun. OLLAMA_URL, vector cache'in embedding
# tarafıyla (aşağıda, VECTOR_CACHE bölümünde) PAYLAŞILAN AYNI değişkendir — iki ayrı .env satırı
# yazmanıza gerek yok, sadece OLLAMA_MODEL burada tanımlıdır. OLLAMA_MODEL için BİLİNÇLİ OLARAK
# varsayılan YOK (GEMINI_MODEL'deki AYNI prensip — hangi modeli indirdiğiniz size bağlı; ayrıca
# OLLAMA_EMBEDDING_MODEL'DEN FARKLIDIR, o embedding, bu ise metin/karar üretimi içindir).
OLLAMA_MODEL=

# Ajan / güvenlik limitleri
AGENT_MAX_STEPS=40
AGENT_MAX_REPEATED_ACTIONS=3
AGENT_MIN_CONFIDENCE=0.55
AGENT_STEP_TIMEOUT_MS=15000
AGENT_MAX_ELEMENTS_PER_STEP=80
# LLM isteği (hangi sağlayıcı seçiliyse) bu süreden uzun sürerse iptal edilip adım yeniden denenir.
# Ücretsiz modeller yoğun saatlerde yavaş olabildiği için bilinçli olarak yüksek tutulmuştur.
AGENT_LLM_TIMEOUT_MS=45000

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=10000

# Loglama
RUNS_DIR=./runs
ARTIFACTS_DIR=./artifacts
GENERATED_TESTS_DIR=./generated-tests

# Allure raporu (bkz. AllureReportService) — "allure" npm paketi (Allure Report 3) node_modules
# içine kurulur, ekstra bir kurulum gerekmez.
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# Eski (legacy) frontend uyum katmanı
LEGACY_DEFAULT_BROWSER=chromium

# v2.0 — Selenium Grid 4 hub adresi (opsiyonel). Tanımlıysa, bir run "Selenium Grid üzerinden
# çalıştır" seçeneğiyle başlatıldığında BrowserManager yerel bir tarayıcı yerine bu hub'da bir
# session açar ve dönen CDP adresine bağlanır (bkz. SeleniumGridClient). SADECE Chromium için
# geçerlidir — Firefox/WebKit Grid node'ları Playwright'tan CDP ile erişilemez. Boş bırakılırsa
# Grid seçeneği tamamen devre dışı kalır.
# Örnek (Docker ile yerel bir Grid): docker run -d -p 4444:4444 --shm-size="2g" selenium/standalone-chrome:4
# SELENIUM_GRID_URL=http://localhost:4444

# v2.0 — Vector DB (Milvus) tabanlı "locator cache" (opsiyonel). Varsayılan OLARAK KAPALIDIR;
# hiçbir Milvus/Ollama kurulumu olmadan projenin geri kalanı hiçbir şekilde etkilenmez, yazma
# tarafı best-effort'tur (bkz. AgentLoop.recordDecisionInCache). Kurulum:
#   1) Milvus + Attu'yu ayağa kaldırın: docker compose -f docker-compose.milvus.yml up -d
#   2) Ollama'yı kurup çalıştırın (https://ollama.com/download), sonra bir Qwen embedding modeli
#      indirin: ollama pull <model-adı> (güncel/kullanılabilir tag için https://ollama.com/search?c=embedding)
#   3) Aşağıdaki 4 satırı doldurun.
VECTOR_CACHE_ENABLED=false
# Not: LLM_PROVIDER=ollama kullanıyorsanız bu adres YUKARIDAKİ OLLAMA_MODEL ile de PAYLAŞILIR —
# aynı sunucu, iki farklı model (biri embedding, biri chat/karar).
OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL için BİLİNÇLİ OLARAK varsayılan YOK (bkz. GEMINI_MODEL'deki AYNI prensip)
# — `ollama pull` ile indirdiğiniz modelin TAM adını buraya yazın.
OLLAMA_EMBEDDING_MODEL=
MILVUS_URL=http://localhost:19530

# v2.0 Faz 2 — OKUMA tarafı (opsiyonel, VECTOR_CACHE_ENABLED=true olmadan etkisizdir). true iken
# AgentLoop, benzer bir geçmiş karar bulunca LLM'e HİÇ danışmadan onu kullanabilir — bu, YUKARIDAKİ
# sadece-yazma modundan FARKLI olarak gerçek kararları etkiler. Önce bir süre sadece yazma
# (VECTOR_CACHE_READ_ENABLED=false) ile veri biriktirip, hazır hissettiğinizde bunu açmanızı öneririz.
VECTOR_CACHE_READ_ENABLED=false
# Bir adayın LLM'siz kullanılabilmesi için gereken minimum kosinüs benzerliği (0-1). Yüksek
# tutulması (varsayılan 0.92) bilinçlidir — şüpheli durumda LLM'e danışmak her zaman daha güvenlidir.
VECTOR_CACHE_MIN_SIMILARITY=0.92
VECTOR_CACHE_TOP_K=5
# v2.3 — Ollama'nın embedding üretmesi bu süreden uzun sürerse iptal edilir (yazma best-effort'tur,
# run'ı ETKİLEMEZ, sadece o kararın cache'e yazılması atlanır). Yerel modelin İLK istekte Ollama'nın
# belleğine yüklenmesi ("cold start") — özellikle sınırlı RAM'de ve büyükçe modellerde (4b gibi) —
# uzun sürebildiği için varsayılan bilinçli olarak yüksek (60sn) tutuldu; hâlâ zaman aşımına
# takılıyorsanız ya bu değeri artırın ya da testten önce modeli "ısıtın":
#   curl http://localhost:11434/api/embeddings -d '{"model":"<OLLAMA_EMBEDDING_MODEL>","prompt":"isinma"}'
VECTOR_CACHE_EMBED_TIMEOUT_MS=60000

# Statik frontend dosyalarının bulunduğu klasör (backend tarafından aynı origin'den sunulur).
# Varsayılan, backend'in bir üst dizinindeki "frontend" klasörünü varsayar.
FRONTEND_DIR=../frontend
